  "records": [
    {
      "resource_id": "data/language/script_code.dat::block:0042",
      "block_index": 42,
      "translation_runs": [
        {
          "stable_key": "data/language/script_code.dat::block:0042::s0",
          "source_segment_index": 0,
          "zh": "「第１太阳时代毁于洪水，",
          "source_token_offset": 0,
          "source_tokens_sha256": "f1383415237211090eda274410e8cad9625da1d1b26532788b0135037e6da58b",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0042::s3",
          "source_segment_index": 3,
          "zh": "第２太阳时代毁于风神，",
          "source_token_offset": 19,
          "source_tokens_sha256": "1186d768ac59e22fd067fccdf5c16926a41bbc4e60eb8f57ab62cee85568c3d8",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0042::s6",
          "source_segment_index": 6,
          "zh": "第３太阳时代毁于火神，",
          "source_token_offset": 38,
          "source_tokens_sha256": "91f8e4f7aba810d1b46e9d113b5d0ff29c00f22ad9cc8bcfef543b031388891e",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0042::s9",
          "source_segment_index": 9,
          "zh": "第４太阳时代毁于血与火之雨。」",
          "source_token_offset": 57,
          "source_tokens_sha256": "b7873df9f6eeffeef2061f38ebfb14b824efeaa19ca11161419040ddc6e7df7f",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0042::s11",
          "source_segment_index": 11,
          "zh": "上面写的，和玛雅预言书里的内容一模一样。",
          "source_token_offset": 83,
          "source_tokens_sha256": "11f968f5128eff4d449b86d01871dbcbca51af4b28f04da0191148a093151f29",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0042::s13",
          "source_segment_index": 13,
          "zh": "这与遗迹有什么关系吗？",
          "source_token_offset": 103,
          "source_tokens_sha256": "7a0b43ff7da59cb7a30683a63e3d83053640d1abb30af699e6039073ceedf4a7",
          "source_kind": "glyph_run"
        }
      ]
    },
    {
      "resource_id": "data/language/script_code.dat::block:0047",
      "block_index": 47,
      "translation_runs": [
        {
          "stable_key": "data/language/script_code.dat::block:0047::s0",
          "source_segment_index": 0,
          "zh": "公会暗中经营店铺。",
          "source_token_offset": 0,
          "source_tokens_sha256": "41df023d3b172d295874e274129da2060b46a0f8c08855692d46c75fb632ba4e",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0047::s2",
          "source_segment_index": 2,
          "zh": "以金钱为代价，便可换得力量。",
          "source_token_offset": 15,
          "source_tokens_sha256": "5ffaaa0750162c1fc279bba2cbc1f50ac22f47d9f2e36fdf6aef9e0c340f7334",
          "source_kind": "glyph_run"
        }
      ]
    },
    {
      "resource_id": "data/language/script_code.dat::block:0052",
      "block_index": 52,
      "translation_runs": [
        {
          "stable_key": "data/language/script_code.dat::block:0052::s0",
          "source_segment_index": 0,
          "zh": "「两名强者」",
          "source_token_offset": 0,
          "source_tokens_sha256": "6f98519152302d46345f04613a313e3b7a29ca68161f617c86e287d2d726cd6d",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0052::s2",
          "source_segment_index": 2,
          "zh": "「归于寂静与孤独」",
          "source_token_offset": 10,
          "source_tokens_sha256": "bc474d8b23794cace2b5506d4375142d5d3fe3722ab8df54a4b0e14d671fca10",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0052::s4",
          "source_segment_index": 4,
          "zh": "「可抵达高处的石头」",
          "source_token_offset": 20,
          "source_tokens_sha256": "d76b01a335bcb7e9e8458ecf6874ae2235635c733b95f56e79f482f39f4bb362",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0052::s6",
          "source_segment_index": 6,
          "zh": "强者……指的是什么？",
          "source_token_offset": 32,
          "source_tokens_sha256": "8136114afdb1fcb0f685fa362f2b532370a4abe6f0252548668a0e1f9cf958d1",
          "source_kind": "glyph_run"
        }
      ]
    },
    {
      "resource_id": "data/language/script_code.dat::block:0057",
      "block_index": 57,
      "translation_runs": [
        {
          "stable_key": "data/language/script_code.dat::block:0057::s0",
          "source_segment_index": 0,
          "zh": "巨人们的悲伤故事。",
          "source_token_offset": 0,
          "source_tokens_sha256": "ca341bf9a58e788a5ab96f884dbbf3c3b1cfda207efdeb3e015a253ba8819813",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0057::s2",
          "source_segment_index": 2,
          "zh": "那里，记载着巨人们悲伤的历史。",
          "source_token_offset": 12,
          "source_tokens_sha256": "d826fedc5fb68eaa2ade51a53d8b5f0674409bd69e1f8f770214caa558dc62c1",
          "source_kind": "glyph_run"
        }
      ]
    },
    {
      "resource_id": "data/language/script_code.dat::block:0060",
      "block_index": 60,
      "translation_runs": [
        {
          "stable_key": "data/language/script_code.dat::block:0060::s0",
          "source_segment_index": 0,
          "zh": "为什么……",
          "source_token_offset": 0,
          "source_tokens_sha256": "8d4c00b7b416af988e7bdda7cffc6b66fb8c47589fe4772840369d55cd49593f",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0060::s2",
          "source_segment_index": 2,
          "zh": "不管试多少次，宝箱都打不开。",
          "source_token_offset": 5,
          "source_tokens_sha256": "48e61a00ee7822128568652ef02cddda4248aefbdeb85664f355b2cddcc47b9e",
          "source_kind": "glyph_run"
        }
      ]
    },
    {
      "resource_id": "data/language/script_code.dat::block:0061",
      "block_index": 61,
      "translation_runs": [
        {
          "stable_key": "data/language/script_code.dat::block:0061::s0",
          "source_segment_index": 0,
          "zh": "不断吸食纯洁少女的生命，",
          "source_token_offset": 0,
          "source_tokens_sha256": "8ce004b5ab3ebd5361d42a9d32383db402d681533b20d127c44b08c3ac8c4101",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0061::s2",
          "source_segment_index": 2,
          "zh": "从而获得永恒之力的魔物，",
          "source_token_offset": 14,
          "source_tokens_sha256": "e65c280716ac739d347bb4a85eb2566e80c879d7ccfaa67db0a060c873858afe",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0061::s5",
          "source_segment_index": 5,
          "zh": "蚩尤",
          "source_token_offset": 29,
          "source_tokens_sha256": "c48380c0b0fedf65296c09c202014a931e1879de19292f118ab98eb67478fdf9",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0061::s7",
          "source_segment_index": 7,
          "zh": "。",
          "source_token_offset": 36,
          "source_tokens_sha256": "877f3713268cdab175893935cd58e2e5c9830c1f4bd1d84995ffc2b7b60b9e03",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0061::s9",
          "source_segment_index": 9,
          "zh": "切莫落入献祭之穴。",
          "source_token_offset": 38,
          "source_tokens_sha256": "aac1ec544da4c3030bed69419767dbf73dcac20c1d6bcf7698616d0b9d7070db",
          "source_kind": "glyph_run"
        }
      ]
    },
    {
      "resource_id": "data/language/script_code.dat::block:0064",
      "block_index": 64,
      "translation_runs": [
        {
          "stable_key": "data/language/script_code.dat::block:0064::s0",
          "source_segment_index": 0,
          "zh": "这是我找到的密道！",
          "source_token_offset": 0,
          "source_tokens_sha256": "4571cb29379614cb3958dce1ff8414da6da4a75fc121ac8b5b58758c8e0d4a07",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0064::s2",
          "source_segment_index": 2,
          "zh": "这座遗迹似乎以不可思议的方式相连……",
          "source_token_offset": 13,
          "source_tokens_sha256": "269c36cc2e6e698a5ef1ac51ebc7c74f4dd50332490e3f967ebfb7a3842ea87f",
          "source_kind": "glyph_run"
        }
      ]
    },
    {
      "resource_id": "data/language/script_code.dat::block:0067",
      "block_index": 67,
      "translation_runs": [
        {
          "stable_key": "data/language/script_code.dat::block:0067::s0",
          "source_segment_index": 0,
          "zh": "矗立于太阳神殿的",
          "source_token_offset": 0,
          "source_tokens_sha256": "3628880b151ea166aa9425e64e453e4b15162203ab96c3ebbe98ef56a8f6473b",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0067::s2",
          "source_segment_index": 2,
          "zh": "望楼",
          "source_token_offset": 14,
          "source_tokens_sha256": "67f20f20069910e2e3fe13f8af506f1fce985eba1e3acde13a70db8dfd2880ba",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0067::s4",
          "source_segment_index": 4,
          "zh": "。",
          "source_token_offset": 20,
          "source_tokens_sha256": "877f3713268cdab175893935cd58e2e5c9830c1f4bd1d84995ffc2b7b60b9e03",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0067::s6",
          "source_segment_index": 6,
          "zh": "为囚禁罪人，又设下新的陷阱。",
          "source_token_offset": 22,
          "source_tokens_sha256": "252097d3ad04379cdf24129990b969643636ea12ab6e8bc8f9cdbf684bb0b6e0",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0067::s8",
          "source_segment_index": 8,
          "zh": "开启之钥，也埋入新筑的墙中。",
          "source_token_offset": 41,
          "source_tokens_sha256": "c887c01bccd2e7964467710da17112d6325676cbc909823d465836cf043f120c",
          "source_kind": "glyph_run"
        }
      ]
    },
    {
      "resource_id": "data/language/script_code.dat::block:0068",
      "block_index": 68,
      "translation_runs": [
        {
          "stable_key": "data/language/script_code.dat::block:0068::s1",
          "source_segment_index": 1,
          "zh": "光辉屏风岩",
          "source_token_offset": 4,
          "source_tokens_sha256": "ac7d640535112098e970997cb59a23b0eef45c069f388f76cd17fcce809a91c9",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0068::s3",
          "source_segment_index": 3,
          "zh": "在哪儿，我知道了！",
          "source_token_offset": 14,
          "source_tokens_sha256": "e1a45f616ff7129cf545c2a470c6d361e3830804e69416d42f0facac105b3de5",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0068::s5",
          "source_segment_index": 5,
          "zh": "可似乎有扇门挡着，过不去……",
          "source_token_offset": 25,
          "source_tokens_sha256": "76730439146b8ea273c58a358aa30c3ea842a4ea6cc6edd8687f6720ca88ac35",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0068::s7",
          "source_segment_index": 7,
          "zh": "拉也拉不开，",
          "source_token_offset": 45,
          "source_tokens_sha256": "380b5be0bcab0e4c2045528f342b8340c36fc4391bff8268593a497ca93daa1d",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0068::s9",
          "source_segment_index": 9,
          "zh": "本来就连个能拉的门把手都没有。",
          "source_token_offset": 58,
          "source_tokens_sha256": "6522df3ac25b5ff852224167911d2f88e72a0f1c85e50ae07026e3462959f8d6",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0068::s12",
          "source_segment_index": 12,
          "zh": "……难道这门该用推的……",
          "source_token_offset": 76,
          "source_tokens_sha256": "c8eb21467c06beb657ec32827d282f915b6d65ee12355d7728c7ba50cf9c6767",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0068::s14",
          "source_segment_index": 14,
          "zh": "真不甘心。",
          "source_token_offset": 96,
          "source_tokens_sha256": "6c3a5ee71a1b80b2f716213b6fbda72e9d81e37556d183c05d29b26ec4cfa843",
          "source_kind": "glyph_run"
        }
      ]
    },
    {
      "resource_id": "data/language/script_code.dat::block:0069",
      "block_index": 69,
      "translation_runs": [
        {
          "stable_key": "data/language/script_code.dat::block:0069::s0",
          "source_segment_index": 0,
          "zh": "好强。",
          "source_token_offset": 0,
          "source_tokens_sha256": "7e71e2eaf9c99e0dbf3ede760fdba41709e8c3e5a105ec5d603a49eff36dc2c7",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0069::s2",
          "source_segment_index": 2,
          "zh": "那个红色的家伙，",
          "source_token_offset": 5,
          "source_tokens_sha256": "c5965d00c2ea1ee542eaab4863265d4cdfbb2d17080bcd93625c273d2c19e538",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0069::s4",
          "source_segment_index": 4,
          "zh": "也太强了！",
          "source_token_offset": 13,
          "source_tokens_sha256": "c38da9139cd2399128cb680a671f9ebcff3c73d67dff8aa11003931b21ebc3f6",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0069::s6",
          "source_segment_index": 6,
          "zh": "得想办法挡住那骨头攻击才行啊。",
          "source_token_offset": 19,
          "source_tokens_sha256": "f1425321312b10d9e0c9b8c0e46bea6eb52c0c911d434339f8946d8c2b2357e6",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0069::s8",
          "source_segment_index": 8,
          "zh": "哎，",
          "source_token_offset": 43,
          "source_tokens_sha256": "19abd8d83cc95fc976ea71950ec2dd3ad411fd2aa8667795b1ea09fad2bcc0c6",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0069::s10",
          "source_segment_index": 10,
          "zh": "我自己倒早就变成一把骨头了！",
          "source_token_offset": 47,
          "source_tokens_sha256": "e48a4b96878da9c76677c3a98f0df543871b121af9a234e04ae387677691abfd",
          "source_kind": "glyph_run"
        }
      ]
    },
    {
      "resource_id": "data/language/script_code.dat::block:0070",
      "block_index": 70,
      "translation_runs": [
        {
          "stable_key": "data/language/script_code.dat::block:0070::s0",
          "source_segment_index": 0,
          "zh": "我究竟已经掉到这里多少次了……",
          "source_token_offset": 0,
          "source_tokens_sha256": "82626c3c13cd35815a718aa8ed9180f7c9ffc107aa0320eba82c20eab9ae4f49",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0070::s2",
          "source_segment_index": 2,
          "zh": "这难道也是陷阱？",
          "source_token_offset": 15,
          "source_tokens_sha256": "f747b25f2507d22c562a544e3c575f48b462df58e20c4cfebdc87d5ce85d1cdc",
          "source_kind": "glyph_run"
        }
      ]
    },
    {
      "resource_id": "data/language/script_code.dat::block:0071",
      "block_index": 71,
      "translation_runs": [
        {
          "stable_key": "data/language/script_code.dat::block:0071::s0",
          "source_segment_index": 0,
          "zh": "衔于口中，彼此相连之物。",
          "source_token_offset": 0,
          "source_tokens_sha256": "25bae31a3051072891c2bc71541ab624a10b24757932ff9b14fc9f52b1b49f27",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0071::s2",
          "source_segment_index": 2,
          "zh": "一人吞下，另一人便会吐出。",
          "source_token_offset": 14,
          "source_tokens_sha256": "adc862212a9c2b4ee67e80a06e0516128e1ca8dd99f0c65ff99a0198492d85fa",
          "source_kind": "glyph_run"
        }
      ]
    },
    {
      "resource_id": "data/language/script_code.dat::block:0072",
      "block_index": 72,
      "translation_runs": [
        {
          "stable_key": "data/language/script_code.dat::block:0072::s1",
          "source_segment_index": 1,
          "zh": "唱诵吧。",
          "source_token_offset": 2,
          "source_tokens_sha256": "0eb85e8a48fafa47902eee4948ca2661e02ddd317010e26b6f05982af8bfef8d",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0072::s3",
          "source_segment_index": 3,
          "zh": "万物始祖之名。",
          "source_token_offset": 7,
          "source_tokens_sha256": "5b3f6cbcb1693d579110158a43f2980697b5df18564353be989155dae30c4b0e",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0072::s5",
          "source_segment_index": 5,
          "zh": "并赐予其永恒的长眠。",
          "source_token_offset": 20,
          "source_tokens_sha256": "bb6dda30e2e5a8c8e0fd8bf08a0fcd85a83d5f615c642c71aaeaa5f79c9bd312",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0072::s7",
          "source_segment_index": 7,
          "zh": "以最后之子的身份。",
          "source_token_offset": 36,
          "source_tokens_sha256": "9f3fa8aac4529a3b52e967e958758532badc75cb716b4eba0c3c327c291725fc",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0072::s10",
          "source_segment_index": 10,
          "zh": "ＬＡＭＵＬＡＮＡ",
          "source_token_offset": 49,
          "source_tokens_sha256": "0dd606eaa578fed748ff950794bd33b6c676da3ab5079e651182b927a1551fd6",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0072::s12",
          "source_segment_index": 12,
          "zh": "。",
          "source_token_offset": 61,
          "source_tokens_sha256": "8c0552cb287623ee097a08e8a64a341531351e112787ef2e47d918c571c2b60b",
          "source_kind": "glyph_run"
        }
      ]
    },
    {
      "resource_id": "data/language/script_code.dat::block:0552",
