          "zh": "。",
          "source_token_offset": 63,
          "source_tokens_sha256": "a3aebda7ffe26e81dfcb0cd685ce77edac31f37ace4f22e2fd68206fbf58e8b7",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0225::s22",
          "source_segment_index": 22,
          "zh": "循人应走之道前行。",
          "source_token_offset": 69,
          "source_tokens_sha256": "86c26f8d566fe44dd6e079fd666b4933c9bac9915826de44514e2ace32900779",
          "source_kind": "glyph_run"
        }
      ]
    },
    {
      "resource_id": "data/language/script_code.dat::block:0255",
      "block_index": 255,
      "translation_runs": [
        {
          "stable_key": "data/language/script_code.dat::block:0255::s0",
          "source_segment_index": 0,
          "zh": "汝当成为小人。",
          "source_token_offset": 0,
          "source_tokens_sha256": "d3ec5a65f55966e056caa7b6caf5ff7be28f7848d8f41bf2a943bf4d27a9485c",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0255::s2",
          "source_segment_index": 2,
          "zh": "唯有身形渺小者方可前行。",
          "source_token_offset": 8,
          "source_tokens_sha256": "49c20ebe15d355a4a7eb1fdc49907db9208e1daa6af2776323010fac0aadc241",
          "source_kind": "glyph_run"
        }
      ]
    },
    {
      "resource_id": "data/language/script_code.dat::block:0379",
      "block_index": 379,
      "translation_runs": [
        {
          "stable_key": "data/language/script_code.dat::block:0379::s1",
          "source_segment_index": 1,
          "zh": "那脏兮兮的人偶是啥？",
          "source_token_offset": 3,
          "source_tokens_sha256": "7100b550f262e09a7bafd1e01827e83413eedbf4533d4847ac599872ae4a686d",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0379::s3",
          "source_segment_index": 3,
          "zh": "能证明你是个小人",
          "source_token_offset": 18,
          "source_tokens_sha256": "09430e5ff2f72a109c56056dcb1fef2a68f4fe6a1bbf7b2f4f1c821c8926b2dc",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0379::s5",
          "source_segment_index": 5,
          "zh": "的人偶？",
          "source_token_offset": 23,
          "source_tokens_sha256": "8bc96eb7f9405176e2f501d2f74c1caf8dba5c273ede4a058e1cc746a7cf9c7a",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0379::s8",
          "source_segment_index": 8,
          "zh": "这都什么跟什么呀。",
          "source_token_offset": 41,
          "source_tokens_sha256": "4ef941ff54cb0150f43b55fd24fb7cffb216aa26ec8241a541f0387d851dcfa4",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0379::s10",
          "source_segment_index": 10,
          "zh": "找个显得自己很小的地方，",
          "source_token_offset": 52,
          "source_tokens_sha256": "9b1545aff16d9fca1d6714572848288c32d6e686d101b3559e0b298c057e304b",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0379::s12",
          "source_segment_index": 12,
          "zh": "用它试试看嘛。",
          "source_token_offset": 64,
          "source_tokens_sha256": "7dada13e2b61b03f006875df96cd1de2f8e03737db3421a8b15f3f7051885a42",
          "source_kind": "glyph_run"
        }
      ]
    },
    {
