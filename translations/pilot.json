  "records": [
    {
      "resource_id": "data/language/script_code.dat::block:0054",
      "block_index": 54,
      "translation_runs": [
        {
          "stable_key": "data/language/script_code.dat::block:0054::s0",
          "source_segment_index": 0,
          "zh": "这些字跟天书似的……",
          "source_token_offset": 0,
          "source_tokens_sha256": "45c0d1c9ee6271ea97d4a8c62463d44801de0a357c45c431aa746cc5aa6d6d98",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0054::s3",
          "source_segment_index": 3,
          "zh": "古文书阅读器",
          "source_token_offset": 13,
          "source_tokens_sha256": "38e6b3cd158af6362d4e865d0e77f19afd2ce5b16740e80054a7b9224e336a0a",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0054::s5",
          "source_segment_index": 5,
          "zh": "……早知道就买了。",
          "source_token_offset": 25,
          "source_tokens_sha256": "03bd647ce00558135eefe04d5604bbe601569ec9ecdc69f365d0e8c803ef4328",
          "source_kind": "glyph_run"
        }
      ]
    },
    {
      "resource_id": "data/language/script_code.dat::block:0065",
      "block_index": 65,
      "translation_runs": [
        {
          "stable_key": "data/language/script_code.dat::block:0065::s0",
          "source_segment_index": 0,
          "zh": "将记忆注入圣杯。",
          "source_token_offset": 0,
          "source_tokens_sha256": "13f4b2846ee7e1122038b7e3ef5876b8d18c27d0add27a8b63423a655f83c404",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0065::s2",
          "source_segment_index": 2,
          "zh": "留下曾到此地的记录。",
          "source_token_offset": 13,
          "source_tokens_sha256": "d3fd5921706d71d6d109c8b4b94f92ce19c5cb4c746bf07978dc059555786412",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0065::s4",
          "source_segment_index": 4,
          "zh": "然后高举圣杯，",
          "source_token_offset": 27,
          "source_tokens_sha256": "d59f0dd08a3669d9737c26e121597451d0b2fb9540d27c39955a82a121883a4f",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0065::s6",
          "source_segment_index": 6,
          "zh": "回想记下的土地。",
          "source_token_offset": 40,
          "source_tokens_sha256": "164b5066282bf7f71430e7525a94f718fbf4d17054498c9da21bba3a6a4e642e",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0065::s8",
          "source_segment_index": 8,
          "zh": "如此，汝便能重临此地。",
          "source_token_offset": 53,
          "source_tokens_sha256": "cc9a92fe43ad088d78e6e8a1b88def06ccda1442fcedeccadaa8d649bbdd4e87",
          "source_kind": "glyph_run"
        }
      ]
    },
    {
      "resource_id": "data/language/script_code.dat::block:0101",
      "block_index": 101,
      "translation_runs": [
        {
          "stable_key": "data/language/script_code.dat::block:0101::s0",
          "source_segment_index": 0,
          "zh": "取镜在手。",
          "source_token_offset": 0,
          "source_tokens_sha256": "d605de817d2c3ed0fe26f32ceb8619cc1ed3353084ed3068a3b7cfb0a7403a7c",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0101::s2",
          "source_segment_index": 2,
          "zh": "镜将映出遗迹的真相。",
          "source_token_offset": 8,
          "source_tokens_sha256": "b1ed2ee0ddf7c2459a6fc614cffa89b1f3db6597bd7ec4656533f729cc265d35",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0101::s4",
          "source_segment_index": 4,
          "zh": "每个房间皆有表与里，",
          "source_token_offset": 23,
          "source_tokens_sha256": "38fcb6df6cfa2bbc7f0d6e3221c80244d581df50150604c9646b47239c6ba460",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0101::s6",
          "source_segment_index": 6,
          "zh": "二者合而为一。",
          "source_token_offset": 33,
          "source_tokens_sha256": "f92831d1e9917091160a3b5df2ee78c6ec6a6648e9d5c1a692a002eaa151015e",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0101::s8",
          "source_segment_index": 8,
          "zh": "踏入黑暗，",
          "source_token_offset": 44,
          "source_tokens_sha256": "b8a0e168d5e9140ab963d15a8a001947a464c82e08c93157b4a82814cc4d1139",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0101::s10",
          "source_segment_index": 10,
          "zh": "下行，",
          "source_token_offset": 51,
          "source_tokens_sha256": "f5299c5ee58b37b7d891e7e717ddfa3acf11d6e73cbb5c5ae36de95d87bfb7d9",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0101::s12",
          "source_segment_index": 12,
          "zh": "前行，",
          "source_token_offset": 55,
          "source_tokens_sha256": "889bbaf617cdb817bcecf727aed84026974de3468f3cb36defc97b2495b4d3ca",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0101::s14",
          "source_segment_index": 14,
          "zh": "攀上，",
          "source_token_offset": 59,
          "source_tokens_sha256": "5cb32c5d3e9eca7d30b759bb24c21500d5f853dcab06314f37c127a94f5433ad",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0101::s16",
          "source_segment_index": 16,
          "zh": "跃起击打。",
          "source_token_offset": 63,
          "source_tokens_sha256": "3e2bb19d30874852424b165ba2700137e79f39be37500ec462ff28f3ed1135ae",
          "source_kind": "glyph_run"
        }
      ]
    },
    {
