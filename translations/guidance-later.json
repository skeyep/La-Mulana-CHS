          "source_token_offset": 0,
          "source_tokens_sha256": "6bf708b922c5ca9544b1fa840fd49db69da9810836d4c597da48086a58ef8851",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0552::s2",
          "source_segment_index": 2,
          "zh": "遍布各区域的十字架。",
          "source_token_offset": 20,
          "source_tokens_sha256": "346e29765fd7646cccf1ea10219027cdd2103191aff5cfa6491e789aeecb6488",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0552::s4",
          "source_segment_index": 4,
          "zh": "全都是后世所立。",
          "source_token_offset": 41,
          "source_tokens_sha256": "1112f58e5baf32dc416cc05405dd590d047c565132ab476e2ed7cc72f5e44d48",
          "source_kind": "glyph_run"
        }
      ]
    },
