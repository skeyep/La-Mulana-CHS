          "zh": "洪水之碑",
          "source_token_offset": 0,
          "source_tokens_sha256": "e03f45225cd6beaf4e3173217b6510eba6c68df69243ed968133afd805aeffce",
          "source_kind": "glyph_run"
        }
      ]
    },
    {
      "resource_id": "data/language/script_code.dat::block:0554",
