      "translation_runs": [
        {
          "stable_key": "data/language/script_code.dat::block:0554::s0",
          "source_segment_index": 0,
          "zh": "风之碑",
          "source_token_offset": 0,
          "source_tokens_sha256": "0b29dcb4f5db9e09558185eb790cdf7b5b3428653d5ac51dc7ad95bf0beb2078",
          "source_kind": "glyph_run"
        }
      ]
    },
    {
      "resource_id": "data/language/script_code.dat::block:0555",
      "block_index": 555,
      "translation_runs": [
        {
          "stable_key": "data/language/script_code.dat::block:0555::s0",
          "source_segment_index": 0,
          "zh": "火之碑",
          "source_token_offset": 0,
          "source_tokens_sha256": "fcf6bb66476bdad9a84f32f83faccbdcb9a4769eec9e6b538537df1ca6897baa",
          "source_kind": "glyph_run"
        }
      ]
    },
    {
      "resource_id": "data/language/script_code.dat::block:0556",
      "block_index": 556,
      "translation_runs": [
        {
          "stable_key": "data/language/script_code.dat::block:0556::s0",
          "source_segment_index": 0,
          "zh": "血与火之雨的石碑",
          "source_token_offset": 0,
          "source_tokens_sha256": "c3bd43ceb7b344fe3ab783956569adaaf4b2ca992b1e3b456f31f7e8fe3caee1",
          "source_kind": "glyph_run"
        }
      ]
    },
    {
      "resource_id": "data/language/script_code.dat::block:0557",
      "block_index": 557,
      "translation_runs": [
        {
          "stable_key": "data/language/script_code.dat::block:0557::s0",
          "source_segment_index": 0,
          "zh": "［考古学事典＞机械之神］",
          "source_token_offset": 0,
          "source_tokens_sha256": "ca95f9cec3fea72700ff7dd633292d2869afa1f75f34736a1ae750a9e95afe1f",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0557::s2",
          "source_segment_index": 2,
          "zh": "与拉文塔遗址",
          "source_token_offset": 16,
          "source_tokens_sha256": "a281e12056f1a76027e6e8fb02caada5f22f6b5f1c74ec5b0b40c2b766a239a8",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0557::s4",
          "source_segment_index": 4,
          "zh": "出土的壁画极为相似。",
          "source_token_offset": 23,
          "source_tokens_sha256": "d86db5467f6bf5884522faee94c4d4e8ab26a753dd5e266eb0871cc6d51483a9",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0557::s6",
          "source_segment_index": 6,
          "zh": "拉文塔是墨西哥的奥尔梅克文明遗址。",
          "source_token_offset": 40,
          "source_tokens_sha256": "b779bb06b5c622790c74b6a0dee0bf46de2ff206875bfecba3d474fc91c27848",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0557::s8",
          "source_segment_index": 8,
          "zh": "看上去像是骑在龙形机械上的人。",
          "source_token_offset": 52,
          "source_tokens_sha256": "2968b8deab993ddc6d25968e4de5ab93e03b96c21d7c8f0e47609e9f890d8f81",
          "source_kind": "glyph_run"
        }
      ]
    },
    {
      "resource_id": "data/language/script_code.dat::block:0558",
      "block_index": 558,
      "translation_runs": [
        {
          "stable_key": "data/language/script_code.dat::block:0558::s0",
          "source_segment_index": 0,
          "zh": "［考古学事典＞古代玛雅的飞行艇？］",
          "source_token_offset": 0,
          "source_tokens_sha256": "579e1a52e1107f47e38f3e8afe79fac7865e408a329b1d937e7ab201325bc3d9",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0558::s2",
          "source_segment_index": 2,
          "zh": "与墨西哥的",
          "source_token_offset": 18,
          "source_tokens_sha256": "a281e12056f1a76027e6e8fb02caada5f22f6b5f1c74ec5b0b40c2b766a239a8",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0558::s4",
          "source_segment_index": 4,
          "zh": "奥尔梅克文明遗物极为相似。",
          "source_token_offset": 25,
          "source_tokens_sha256": "6a2b2ed66c7fc9793861cf27a3854d58eda9a88108fea89f5dcf4f8b5ad21e60",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0558::s6",
          "source_segment_index": 6,
          "zh": "虽是带装饰的笛子，",
          "source_token_offset": 39,
          "source_tokens_sha256": "87f3c1c8b72c7da21caab710a088b9089004438c49032faf05c6494863a61ed3",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0558::s8",
          "source_segment_index": 8,
          "zh": "却也像是乘着飞行艇的人。",
          "source_token_offset": 50,
          "source_tokens_sha256": "b15556a285456ae91a3de1106947e7cc351b5446706147227dfa23f4447b30bc",
          "source_kind": "glyph_run"
        }
      ]
    },
    {
      "resource_id": "data/language/script_code.dat::block:0580",
      "block_index": 580,
      "translation_runs": [
        {
          "stable_key": "data/language/script_code.dat::block:0580::s0",
          "source_segment_index": 0,
          "zh": "［穆拉纳遗迹事典＞封印之墙］",
          "source_token_offset": 0,
          "source_tokens_sha256": "1f5620f047936c757865313fb8dcce627296476cea1067c05494c4e9ef5c1f56",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0580::s2",
          "source_segment_index": 2,
          "zh": "带有巨大眼睛浮雕的墙壁。",
          "source_token_offset": 21,
          "source_tokens_sha256": "942ddbf9ac128fb1cbb43a359425da346bb1efb8770c41e8f6acc8882376c0ff",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0580::s4",
          "source_segment_index": 4,
          "zh": "似乎是用来藏起某种重要之物的。",
          "source_token_offset": 36,
          "source_tokens_sha256": "16f8d5625bd382e2cc23b9226abc4b5374bf8d745bd5ff2f115987aada604dd3",
          "source_kind": "glyph_run"
        }
      ]
    },
    {
      "resource_id": "data/language/script_code.dat::block:0583",
      "block_index": 583,
      "translation_runs": [
        {
          "stable_key": "data/language/script_code.dat::block:0583::s0",
          "source_segment_index": 0,
          "zh": "［考古学事典＞俄安内］",
          "source_token_offset": 0,
          "source_tokens_sha256": "92463f1a119e80cc1885fe01cbdc6314a2004c29f7b50be79f7541c43d809c82",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0583::s2",
          "source_segment_index": 2,
          "zh": "巴比伦神话中，",
          "source_token_offset": 14,
          "source_tokens_sha256": "abfa2adb0926f7ad5ea6d7e00a3f1394c8d366078b41c16fa759767190eed096",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0583::s4",
          "source_segment_index": 4,
          "zh": "据说曾将文明传授给苏美尔人的",
          "source_token_offset": 25,
          "source_tokens_sha256": "ea525a77cd6e72ebc90eaca56e08e9d9da91603f2fddb44d93950d3af8dd667a",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0583::s6",
          "source_segment_index": 6,
          "zh": "半鱼人。",
          "source_token_offset": 36,
          "source_tokens_sha256": "59c55dfee33c846518d5f66e621abca23d453ce3840ce90d3b44c11492cb2072",
          "source_kind": "glyph_run"
        }
      ]
    },
    {
      "resource_id": "data/language/script_code.dat::block:0591",
      "block_index": 591,
      "translation_runs": [
        {
          "stable_key": "data/language/script_code.dat::block:0591::s0",
          "source_segment_index": 0,
          "zh": "［调查模式］",
          "source_token_offset": 0,
          "source_tokens_sha256": "1dd2a63addbcdca778f07a83b8c48a89c7350397b8c3ffa00f7655cf700e44c5",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0591::s2",
          "source_segment_index": 2,
          "zh": "墙中嵌有一个方块。",
          "source_token_offset": 8,
          "source_tokens_sha256": "523b5c0dc835653ac60eeeaa37512891c4153451457f3ee3a34f00b264963cfc",
          "source_kind": "glyph_run"
        }
      ]
    },
    {
      "resource_id": "data/language/script_code.dat::block:0727",
      "block_index": 727,
      "translation_runs": [
        {
          "stable_key": "data/language/script_code.dat::block:0727::s1",
          "source_segment_index": 1,
          "zh": "竟能找到此处。",
          "source_token_offset": 3,
          "source_tokens_sha256": "043c72b4d04f20227f5911343c4566439c29d34ea1480cd445c1f575c4a52fde",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0727::s3",
          "source_segment_index": 3,
          "zh": "吾名杜拉库艾茨。",
          "source_token_offset": 15,
          "source_tokens_sha256": "6f3818e27d563a621857e7abe96ace5c4a0803b89865b84761b0c61c84531599",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0727::s5",
          "source_segment_index": 5,
          "zh": "乃是未能成为贤者之人。",
          "source_token_offset": 28,
          "source_tokens_sha256": "ffc01755d7640925477c94c016254f7e8d2e23455682fa2db38e2f3ba2d2a852",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0727::s7",
          "source_segment_index": 7,
          "zh": "吾曾造出一件宝物。",
          "source_token_offset": 41,
          "source_tokens_sha256": "583a8f8e61d8cc3b0999728fd8b242fa4fbef65d787d058429a4436e70e3eb39",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0727::s9",
          "source_segment_index": 9,
          "zh": "它未获任何人的认可，",
          "source_token_offset": 51,
          "source_tokens_sha256": "60e68c6e8bbac5e267c6e9275215d682a0ecde2ed8151221e0ddaf7d620f4c14",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0727::s11",
          "source_segment_index": 11,
          "zh": "吾也未能成为贤者。",
          "source_token_offset": 64,
          "source_tokens_sha256": "8f4f0df9c119848dffd666e31520f8b5ea5b4345b5c06f5ffbc9e692ca1ad05a",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0727::s13",
          "source_segment_index": 13,
          "zh": "那是不可窥视、",
          "source_token_offset": 77,
          "source_tokens_sha256": "1f3d0c0536a90ecdfe2cb2253b10d93956b45ae3569777e169bb561deba0a1cf",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0727::s15",
          "source_segment_index": 15,
          "zh": "不可使用的禁断宝物。",
          "source_token_offset": 90,
          "source_tokens_sha256": "0982955cbc40935f16b55c0ed7081d1e4c53f208dbbf475c67e5032277eaa3de",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0727::s17",
          "source_segment_index": 17,
          "zh": "汝若有所求，",
          "source_token_offset": 104,
          "source_tokens_sha256": "70a6d38c2ee7ce1e2649cf2e4df8518ea65d28404ffa2d4c1f603562fd361321",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0727::s19",
          "source_segment_index": 19,
          "zh": "便来寻吾。",
          "source_token_offset": 117,
          "source_tokens_sha256": "2107e1e9c5aea5048d3a9c37ff710126e0c84fcf89e0892724e2afb5aaee37f3",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0727::s21",
          "source_segment_index": 21,
          "zh": "吾是不该存在之人。",
          "source_token_offset": 129,
          "source_tokens_sha256": "876b8399bde6ed79f3e3f8754ae3340801ca1b77d6bbe126478f72d385de6b2d",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0727::s23",
          "source_segment_index": 23,
          "zh": "为免被发现，藏身于此。",
          "source_token_offset": 142,
          "source_tokens_sha256": "0ccc0f5cc3375014a81a199cc12957ed188bf0bdf6b74c3ab3ebafdc5ecec6f6",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0727::s25",
          "source_segment_index": 25,
          "zh": "在绝无可能进入的",
          "source_token_offset": 157,
          "source_tokens_sha256": "8006ef13c23a09334491d6d02660b980cec2e324f68c1ca342a3ec3d79fedd5c",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0727::s27",
          "source_segment_index": 27,
          "zh": "门扉彼方等候。",
          "source_token_offset": 170,
          "source_tokens_sha256": "781ec751e523781d699ce1eddc3482965f99565035cf4eeb445240656f14bcfb",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0727::s29",
          "source_segment_index": 29,
          "zh": "先去与任何谜题都无关的",
          "source_token_offset": 181,
          "source_tokens_sha256": "96a420db79d196cdb0ba82829f6121c329dc4bca60f9b8ee18743c031c542933",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0727::s31",
          "source_segment_index": 31,
          "zh": "石像前，等待",
          "source_token_offset": 194,
          "source_tokens_sha256": "6e1d62ca30cdcf1efb5f37329b62f209d0fc4b83261a9b717a2ee277a5630dd3",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0727::s33",
          "source_segment_index": 33,
          "zh": "夜晚",
          "source_token_offset": 203,
          "source_tokens_sha256": "dca3c470a02862a9e3fafcc99d891f3bda658de56a4633637ed9600bb751e848",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0727::s35",
          "source_segment_index": 35,
          "zh": "降临。",
          "source_token_offset": 208,
          "source_tokens_sha256": "7e684da15dbd7b993203a5da870d78b6deb38a6941c030812607517453d1a06b",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0727::s37",
          "source_segment_index": 37,
          "zh": "而后向",
          "source_token_offset": 213,
          "source_tokens_sha256": "d7aa61791109fdba4772b73791b0b03b857d62ea6abaabe50ce9362f8a67d61a",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0727::s39",
          "source_segment_index": 39,
          "zh": "送行之人",
          "source_token_offset": 220,
          "source_tokens_sha256": "4be1e4c30c3d7c3b32eb0dd56213102b2f9e4575eb8599815c4ceb1828ee194a",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0727::s41",
          "source_segment_index": 41,
          "zh": "求问话语。",
          "source_token_offset": 228,
          "source_tokens_sha256": "983f3740624f9143e6119268d404580fb9ae30dd63374576b1c86bc6e16b1eda",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0727::s43",
          "source_segment_index": 43,
          "zh": "莫使任何人知晓，",
          "source_token_offset": 238,
          "source_tokens_sha256": "3e73e5020baebab550b0efabe46b58bfdad7d3e787bd228d248a93fc82c6e4dd",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0727::s45",
          "source_segment_index": 45,
          "zh": "在夜间来到门前。",
          "source_token_offset": 249,
          "source_tokens_sha256": "464b995f9e24cbffc05f73e0a3b3a5cf7355adf2408eacaccb766aeccf8103d9",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0727::s48",
          "source_segment_index": 48,
          "zh": "还想再听一次吾的话吗？",
          "source_token_offset": 266,
          "source_tokens_sha256": "c0f87f0ff3c0e9788557910169e9c4c5c6a9c61cb71bd39392d11582f79c3131",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0727::s52",
          "source_segment_index": 52,
          "zh": "吾，",
          "source_token_offset": 285,
          "source_tokens_sha256": "98b4137065f43f866d5ec2c42cc3579ca5c809c557318496bf4bb889cb2652d5",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0727::s54",
          "source_segment_index": 54,
          "zh": "拜托了。",
          "source_token_offset": 288,
          "source_tokens_sha256": "9f4d74a16dded18f19a6fe4115d9250a9d0428a10df63d797eeb96b57af92304",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0727::s56",
          "source_segment_index": 56,
