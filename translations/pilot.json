      "translation_runs": [
        {
          "stable_key": "data/language/script_code.dat::block:0427::s0",
          "source_segment_index": 0,
          "zh": "你在遗迹里也住了很久了吧。",
          "source_token_offset": 0,
          "source_tokens_sha256": "3bbb65fc58b6768ae9d4b1adf1f03ea3dacb8e8da4eeae60ac18eb48e26f93e2",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0427::s2",
          "source_segment_index": 2,
          "zh": "如今，穆拉纳的文字",
          "source_token_offset": 17,
          "source_tokens_sha256": "c86c96d2fa8c58ea30be4e09f950f2f616d829221d3c652e38b57ce93cb01f96",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0427::s4",
          "source_segment_index": 4,
          "zh": "不用机器也",
          "source_token_offset": 34,
          "source_tokens_sha256": "88f5844c39415d9a92d72b674986a0022a7b9fa6f1e16c30c2e59df29e845fdd",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0427::s6",
          "source_segment_index": 6,
          "zh": "能读懂了吧？",
          "source_token_offset": 41,
          "source_tokens_sha256": "951112f811331a6ff8e6c9e7b69069af092a91b8cfe65cafdc3cf9d412711593",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0427::s9",
          "source_segment_index": 9,
          "zh": "最容易的就是数字了。",
          "source_token_offset": 56,
          "source_tokens_sha256": "d5373d5d7073126f48ef8a95ef38b2bfbd247c54d34bec5e602cacdca8d69517",
          "source_kind": "glyph_run"
        },
        {
          "stable_key": "data/language/script_code.dat::block:0427::s12",
          "source_segment_index": 12,
          "zh": "每个数字都有自己的含义。",
          "source_token_offset": 73,
          "source_tokens_sha256": "eb430a28588c30b3dafaaeff66476b86e165a20db0598fdf5b9d0daeb7233bb7",
